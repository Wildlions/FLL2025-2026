from pybricks.hubs import PrimeHub
from pybricks.pupdevices import Motor, ColorSensor, UltrasonicSensor, ForceSensor
from pybricks.parameters import Button, Color, Direction, Port, Side, Stop
from pybricks.robotics import DriveBase
from pybricks.tools import wait, StopWatch, multitask, run_task
from umath import sin, cos, tan, pi

tempo = StopWatch()   
hub = PrimeHub()

# Configuração de Motores e Sensores
direito = Motor(Port.E)
esquerdo = Motor(Port.A, Direction.COUNTERCLOCKWISE)
garra_esq = Motor(Port.B, Direction.COUNTERCLOCKWISE)
garra_dir = Motor(Port.F)

# DriveBase Otimizada para FLL
# Dica: Se o robô girar menos de 90°, aumente 104 para 105. Se girar mais, diminua para 103.
mover = DriveBase(esquerdo, direito, 55, 104)
mover.settings(400, 250)
mover.use_gyro(True)

numero = 1
lancamento = 1
hub.system.set_stop_button(Button.BLUETOOTH)

# Variáveis de calibração para os sensores de cor
whiteLow = 95
whiteHigh = 100
blacklow = 10
blackhigh = 20
kD = 0.972
kP = 1.392
erro_ant = 0

