# --- FUNÇÕES DE MOVIMENTAÇÃO OTIMIZADAS ---

def andar(distancia, velocidade = 400):
    mover.settings(velocidade, 650, 100, 100)
    mover.stop()
    hub.imu.reset_heading(0)
    mover.straight(distancia * 10)

def curva(graus, esperar=True, velocidade = 150):
    # Velocidade e aceleração angular reduzidas para evitar que as rodas derrapem
    mover.settings(50, 600, 100, velocidade)
    mover.turn(graus, Stop.HOLD, esperar)
    if esperar:
        wait(100) # Pausa milimétrica para o giroscópio estabilizar o valor real

def arco(raio, graus, velocidade = 300):
    mover.settings(velocidade, 400, 400, 400)
    mover.curve(raio, graus)

def parar():
    mover.stop()
    wait(1)

def esperar(tempo):
    mover.stop()
    wait(tempo * 1000)
    mover.stop()

# --- FUNÇÕES DAS GARRAS (INDIVIDUAIS) ---

def garraD(tempo, velocidade=4000, reverse=False, esperar=True):
    velocidadeR = velocidade * (-1 if reverse else 1)
    garra_dir.run_time(velocidadeR, tempo, wait=esperar)

def garraE(tempo, velocidade=4000, reverse=False, esperar=True):
    velocidadeR = velocidade * (-1 if reverse else 1)
    garra_esq.run_time(velocidadeR, tempo, wait=esperar)

# --- SISTEMA ASYNC: AJUSTE SIMULTÂNEO E REVERSÍVEL ---

async def async_ajusteGarraE(velocidade, torque, reverso):
    sinal = 1 if reverso else -1
    await garra_esq.run_until_stalled(velocidade * sinal, Stop.COAST, torque)

async def async_ajusteGarraD(velocidade, torque, reverso):
    sinal = 1 if reverso else -1
    await garra_dir.run_until_stalled(velocidade * sinal, Stop.COAST, torque)

def ajusteGarrasJuntas(velocidade=4000, torque=50, esq_reverso=False, dir_reverso=False):
    """
    Executa o travamento de ambas as garras ao mesmo tempo.
    Altere esq_reverso ou dir_reverso para True caso precise mudar o sentido de rotação.
    """
    run_task(multitask(
        async_ajusteGarraE(velocidade, torque, esq_reverso), 
        async_ajusteGarraD(velocidade, torque, dir_reverso)
    ))

# --- FUNÇÕES DE ALINHAMENTO / ESTACIONAR ---

def estacionarB(velocidade):
    loop = True
    while loop == True:
        refE = lerE()
        refD = lerD()
        mover.drive(velocidade, 0)
        if (refD >= whiteLow and refD <= whiteHigh) or (refE >= whiteLow and refE <= whiteHigh):
            parar()
            loop = False

def estacionarP(velocidade):
    loop = True
    while loop == True:
        refE = lerE()
        refD = lerD()
        mover.drive(velocidade, 0)
        if refD >= blacklow and refD <= blackhigh and refE >= blacklow and refE <= blackhigh:
            mover.stop()
            loop = False
        else:
            wait(1)

def estacionarT(velocidade):
    erro_ant = 0
    taxaCurva = 0
    while True:
        refE = lerE()
        refD = lerD()
        erro = refD - refE
        derivada = erro - (erro_ant * 0.3)
        taxaCurva = (kP * erro) + (kD * derivada)
        erro_ant = erro

        if refE < blackhigh and refE > blacklow and refD < blackhigh and refD > blacklow:
            mover.stop()
            wait(500)
            break
        else:
            mover.drive(velocidade, taxaCurva)
            wait(10)

async def estacionarE(velocidade, torque=50):
    await esquerdo.run_until_stalled(velocidade, Stop.COAST, torque)

async def estacionarD(velocidade, torque=50):
    await direito.run_until_stalled(velocidade, Stop.COAST, torque)

async def est(velocidade, torque=50):
    await multitask(estacionarE(velocidade, torque), estacionarD(velocidade, torque))

def estacionar(velocidade, torque=31):
    run_task(est(velocidade, torque))
    parar()

