# --- FUNÇÕES DE MOVIMENTAÇÃO OTIMIZADAS ---

def andar(distancia, velocidade = 400):
    mover.settings(velocidade, 650, 100, 100)
    mover.straight(distancia * 10)

def curva(graus, esperar=True, velocidade = 150):
    mover.settings(50, 600, velocidade, 400)
    mover.turn(graus, Stop.HOLD, esperar)
    if esperar:
        wait(100)

def arco(raio, graus, velocidade = 300):
    mover.settings(velocidade, 400, 400, 400)
    mover.curve(raio, graus)

def parar():
    mover.stop()
    wait(1)

def esperar(tempo_s):
    mover.stop()
    wait(tempo_s * 1000)
    mover.stop()

# --- FUNÇÕES DAS GARRAS ---

def garraD(tempo_ms, velocidade=4000, reverse=False, esperar=True):
    velocidadeR = abs(velocidade) * (-1 if reverse else 1)
    garra_dir.run_time(velocidadeR, tempo_ms, wait=esperar)

def garraE(tempo_ms, velocidade=4000, reverse=False, esperar=True):
    velocidadeR = abs(velocidade) * (-1 if reverse else 1)
    garra_esq.run_time(velocidadeR, tempo_ms, wait=esperar)

# --- CALIBRAÇÃO DAS GARRAS ---

def ajusteGarra(lado, velocidade=4000, torque=50, reverso=False):
    # Calibra UMA garra por vez (bancada / testes / recalibração pontual)
    sinal = -1 if reverso else 1
    if lado == "E":
        garra_esq.run_until_stalled(abs(velocidade) * sinal, Stop.COAST, torque)
    elif lado == "D":
        garra_dir.run_until_stalled(abs(velocidade) * sinal, Stop.COAST, torque)
    else:
        print("Lado inválido, use 'E' ou 'D'")

async def async_ajusteGarraE(velocidade, torque, reverso):
    sinal = -1 if reverso else 1
    await garra_esq.run_until_stalled(abs(velocidade) * sinal, Stop.COAST, torque)

async def async_ajusteGarraD(velocidade, torque, reverso):
    sinal = -1 if reverso else 1
    await garra_dir.run_until_stalled(abs(velocidade) * sinal, Stop.COAST, torque)

def ajusteGarrasJuntas(velocidade=4000, torque=50, esq_reverso=False, dir_reverso=False):
    # Calibra as duas garras AO MESMO TEMPO (multitask).
    # esq_reverso e dir_reverso são independentes: dá pra girar cada
    # garra para um lado diferente, ou as duas para o mesmo lado.
    run_task(multitask(
        async_ajusteGarraE(velocidade, torque, esq_reverso), 
        async_ajusteGarraD(velocidade, torque, dir_reverso)
    ))

# --- FUNÇÕES DE ALINHAMENTO (dependem dos sensores de cor — DESATIVADAS) ---
# Não chamar enquanto os sensores não forem reconectados e lerE/lerD reativadas

def estacionarB(velocidade):
    loop = True
    while loop:
        refE = lerE()
        refD = lerD()
        mover.drive(velocidade, 0)
        if (refD >= whiteLow and refD <= whiteHigh) or (refE >= whiteLow and refE <= whiteHigh):
            parar()
            loop = False

def estacionarP(velocidade):
    loop = True
    while loop:
        refE = lerE()
        refD = lerD()
        mover.drive(velocidade, 0)
        if refD >= blacklow and refD <= blackhigh and refE >= blacklow and refE <= blackhigh:
            mover.stop()
            loop = False
        else:
            wait(1)

def estacionarT(velocidade):
    erro_ant = 0
    while True:
        refE = lerE()
        refD = lerD()
        erro = refD - refE
        derivada = erro - erro_ant
        taxaCurva = (kP * erro) + (kD * derivada)
        erro_ant = erro

        if refE < blackhigh and refE > blacklow and refD < blackhigh and refD > blacklow:
            mover.stop()
            wait(500)
            break
        else:
            mover.drive(velocidade, taxaCurva)
            wait(10)

# --- ESTACIONAR MOTORES DE TRAÇÃO (não depende de sensor de cor) ---

async def estacionarE(velocidade, torque=50):
    await esquerdo.run_until_stalled(velocidade, Stop.COAST, torque)

async def estacionarD(velocidade, torque=50):
    await direito.run_until_stalled(velocidade, Stop.COAST, torque)

async def est(velocidade, torque=50):
    await multitask(estacionarE(velocidade, torque), estacionarD(velocidade, torque))

def estacionar(velocidade, torque=31):
    run_task(est(velocidade, torque))
    parar()

